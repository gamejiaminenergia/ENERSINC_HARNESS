# Llave del modelo DeepSeek. Pega la tuya aqui (no se sube al repo).
DEEPSEEK_API_KEY=
# Opcional: endpoint alternativo.
# DEEPSEEK_BASE_URL=

# Servicio CREG (por defecto 3100; el 3000 suele estar ocupado).
CREG_URL=http://127.0.0.1:3100
# Modo del cliente CREG: direct (sin navegador, default), auto o browser.
CREG_MODE=direct

# Opcional: titulo de la pestana de la Web UI durante el build (default: ENERSINC Harness).
# DSH_CLIENT_TITLE=ENERSINC Harness
